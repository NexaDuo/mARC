{
  "team-toml-dump": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash hooks/agy-hook.sh team-toml-dump SessionStart"
      }
    ]
  },
  "outdated-check": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash hooks/agy-hook.sh outdated-check SessionStart"
      }
    ]
  },
  "token-guard": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/agy-hook.sh token-guard PostToolUse"
          }
        ]
      }
    ]
  },
  "outdated-recheck": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/agy-hook.sh outdated-recheck PostToolUse"
          }
        ]
      }
    ]
  },
  "token-telemetry": {
    "Stop": [
      {
        "type": "command",
        "command": "bash hooks/agy-hook.sh token-telemetry Stop"
      }
    ]
  }
}
